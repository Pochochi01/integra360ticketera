PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=integra360_ticketera
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# URL pública del frontend (links de venta y link de entradas por WhatsApp)
FRONTEND_URL=http://localhost:5173
# URL pública del backend: MercadoPago envía los webhooks a BACKEND_PUBLIC_URL/api/pagos/webhook/mercadopago/:ambito
# (en desarrollo local usar un túnel, ej. ngrok, para recibirlos)
BACKEND_PUBLIC_URL=http://localhost:4000
# Dominios base para detectar el tenant por subdominio (norte.midominio.com → "norte")
TENANT_BASE_DOMAINS=localhost,integra360.com

# Clave de 32 bytes (hex) para cifrar credenciales de MercadoPago / Meta guardadas en la base.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ¡No cambiarla una vez guardadas integraciones!
CREDENTIALS_KEY=

# ---------- MercadoPago (OAuth) ----------
# Una sola aplicación registrada en https://www.mercadopago.com.ar/developers/panel/app
# Cada complejo y la plataforma vinculan SU cuenta con el botón «Conectar con MercadoPago»:
# no se pegan access tokens en ningún lado. Los tokens se guardan cifrados y se renuevan solos.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la «URL de redireccionamiento» de la aplicación.
# Por defecto: BACKEND_PUBLIC_URL/api/auth/mercadopago/callback
MP_REDIRECT_URI=
# Clave secreta de webhooks de la aplicación (Webhooks → «Clave secreta»): valida x-signature
MP_WEBHOOK_SECRET=
# true sólo si se activó PKCE en «Detalles de aplicación» (ahí pasa a ser obligatorio)
MP_PKCE=false
# true = pedir credenciales de prueba (sandbox) al vincular
MP_TEST_TOKEN=false
# Renovar el access token cuando le queden menos de N días (dura 180)
MP_RENOVAR_ANTES_DIAS=7
MP_AUTH_URL=https://auth.mercadopago.com/authorization
MERCADOPAGO_API_URL=https://api.mercadopago.com
# Links de pago de vendedores: horas que se reservan las entradas
LINK_MP_RESERVA_HORAS=24
EFECTIVO_RESERVA_HORAS=72
# Pasarela simulada (tarjeta 4111 1111 1111 1111 / billetera) sólo para desarrollo
PAGOS_SIMULADOS=false

# WhatsApp: cada complejo usa el chatbot que le configura el superadmin (Meta o Baileys).
# Respaldo si un complejo no tiene chatbot: console (imprime el mensaje) | none (falla)
WHATSAPP_FALLBACK=console
WHATSAPP_PAIS_DEFECTO=AR
META_GRAPH_URL=https://graph.facebook.com/v21.0
# Baileys guarda la sesión en MySQL (tabla baileys_auth). Esta carpeta sólo se usa para archivar sesiones
# del formato anterior (archivos) al migrar.
BAILEYS_SESSIONS_DIR=./sessions
# Nivel de log de Baileys: silent | warn | info | debug (diagnóstico)
BAILEYS_LOG_LEVEL=silent
